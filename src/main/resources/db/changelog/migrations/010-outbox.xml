<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="010-outbox" author="edwin">
        <createTable tableName="outbox_events">
            <column name="id" type="UUID">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_outbox_events"
                        nullable="false"/>
            </column>
            <column name="topic" type="VARCHAR(249)">
                <constraints nullable="false"/>
            </column>
            <column name="aggregate_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="aggregate_id" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column
                    name="created_at"
                    type="TIMESTAMPTZ"
                    defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex
                tableName="outbox_events"
                indexName="idx_outbox_event_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-debezium-role" author="edwin" dbms="postgresql">
        <sql splitStatements="false">
            DO $$
                BEGIN
                    IF NOT EXISTS (
                        SELECT 1
                        FROM pg_roles
                        WHERE rolname = 'debezium'
                    ) THEN
                        CREATE ROLE debezium
                            WITH LOGIN
                            REPLICATION
                            PASSWORD 'debezium';
                    ELSE
                        ALTER ROLE debezium
                            WITH LOGIN
                            REPLICATION;
                    END IF;
                END
            $$;
        </sql>

        <sql>
            GRANT CONNECT ON DATABASE polybank_db TO debezium;
            GRANT USAGE ON SCHEMA public TO debezium;
            GRANT SELECT ON TABLE public.outbox_events TO debezium;
        </sql>

        <rollback>
            REVOKE SELECT ON TABLE public.outbox_events FROM debezium;
            REVOKE USAGE ON SCHEMA public FROM debezium;
            REVOKE CONNECT ON DATABASE polybank_db FROM debezium;
        </rollback>
    </changeSet>

    <changeSet id="010-outbox-publication" author="edwin" dbms="postgresql">
        <sql splitStatements="false">
            DO $$
                BEGIN
                    IF NOT EXISTS (
                        SELECT 1
                        FROM pg_publication
                        WHERE pubname = 'polybank_outbox_publication'
                    ) THEN
                        CREATE PUBLICATION polybank_outbox_publication
                            FOR TABLE public.outbox_events;

                    ELSIF NOT EXISTS (
                        SELECT 1
                        FROM pg_publication_tables
                        WHERE pubname = 'polybank_outbox_publication'
                          AND schemaname = 'public'
                          AND tablename = 'outbox_events'
                    ) THEN
                        ALTER PUBLICATION polybank_outbox_publication
                            ADD TABLE public.outbox_events;
                    END IF;
                END
            $$;
        </sql>

        <rollback>
            DROP PUBLICATION IF EXISTS polybank_outbox_publication;
        </rollback>
    </changeSet>

</databaseChangeLog>