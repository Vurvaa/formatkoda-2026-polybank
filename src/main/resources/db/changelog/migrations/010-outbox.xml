<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="010-outbox" author="edwin">
        <createTable tableName="outbox_events">
            <column name="id" type="UUID">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_outbox_events"
                        nullable="false"/>
            </column>
            <column name="topic" type="VARCHAR(249)">
                <constraints nullable="false"/>
            </column>
            <column name="aggregate_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="aggregate_id" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column
                    name="created_at"
                    type="TIMESTAMPTZ"
                    defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex
                tableName="outbox_events"
                indexName="idx_outbox_event_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>